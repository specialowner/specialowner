rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isActiveResident() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // A resident may only touch their own activation-request fields — not role, accountStatus, or points.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['activationRequestStatus', 'activationRequestedAt']));
      allow delete: if isAdmin();
    }

    match /invitations/{inviteId} {
      allow read: if isSignedIn(); // security/admin need to read any invite to validate a scan
      allow create: if isOwner(resource == null ? request.resource.data.residentId : resource.data.residentId) && isActiveResident();
      allow update: if isAdmin(); // only admin/security marks an invite as used
      allow delete: if isAdmin();
    }

    match /payments/{payId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.residentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /maintenanceRequests/{reqId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.residentId == request.auth.uid);
      allow create: if isOwner(request.resource.data.residentId) && isActiveResident();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /workers/{workerId} {
      allow read, write: if isAdmin();
    }

    match /accessLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /pointsTransactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.residentId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
